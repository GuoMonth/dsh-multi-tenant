{
  "name": "dsh-multi-tenant",
  "version": "0.12.0",
  "description": "Self-hosted multi-tenant DeepSeek Harness access with OIDC and a pluggable environment contract",
  "author": "DeepSeek Harness community contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GuoMonth/dsh-multi-tenant.git"
  },
  "homepage": "https://github.com/GuoMonth/dsh-multi-tenant#readme",
  "bugs": {
    "url": "https://github.com/GuoMonth/dsh-multi-tenant/issues"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest",
    "provenance": true
  },
  "sideEffects": false,
  "type": "module",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "AI.md",
    "charts",
    "THIRD_PARTY_NOTICES"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "multi-tenant",
    "kubernetes",
    "oidc",
    "self-hosted",
    "persistent-storage",
    "runtime",
    "ai-agents"
  ],
  "engines": {
    "node": "^24.22.3 || >=26.13.1"
  },
  "devDependencies": {
    "@types/ws": "8.18.2",
    "openid-client": "6.9.0",
    "ws": "8.23.0",
    "zod": "4.6.7"
  },
  "scripts": {
    "build": "node ../../scripts/package-installation.ts && tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "dshRuntime": {
    "version": "0.2.2-rc.5",
    "commit": "9c2670d3bce5275e0d1610272958121af87787bb"
  },
  "bin": {
    "dsh-multi-tenant": "dist/cli.mjs"
  }
}
