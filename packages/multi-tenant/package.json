{
  "name": "dsh-multi-tenant",
  "version": "0.8.0",
  "description": "Principal-isolated native DeepSeek Harness Hosts: domain directory, runtime lifecycle and authenticated HTTP/WebSocket ingress.",
  "author": "DeepSeek Harness community contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GuoMonth/dsh-multi-tenant.git"
  },
  "homepage": "https://github.com/GuoMonth/dsh-multi-tenant#readme",
  "bugs": {
    "url": "https://github.com/GuoMonth/dsh-multi-tenant/issues"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest",
    "provenance": true
  },
  "sideEffects": false,
  "type": "module",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./native/runtime-control.mjs": "./src/native/runtime-control.mjs"
  },
  "files": [
    "dist",
    "src/native/runtime-control.mjs",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "examples",
    "CHANGELOG.md",
    "runtime",
    "src/native/tcp-relay.mjs",
    "experience",
    "runtime-manifest.json"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "multi-tenant",
    "principal-isolation",
    "runtime",
    "saas"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "tsdown": "^0.22.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "ws": "8.18.3",
    "@types/ws": "8.18.1"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "prepare": "tsdown"
  },
  "dshRuntime": {
    "version": "0.1.5-rc.2",
    "commit": "fb2c4b9e698e30edb738bca4cf0618587db7d203"
  },
  "bin": {
    "dsh-multi-tenant": "dist/cli.mjs"
  }
}
