{
  "name": "dsh-multi-tenant-root",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "peers:check": "pnpm peers check",
    "verify": "node scripts/verify-packages.mjs && node scripts/verify-contract.mjs && node --test scripts/tests/*.test.mjs",
    "probe:sqlite": "node scripts/sqlite-domain-repository-probe.mjs",
    "probe:platform": "pnpm probe:isolated",
    "probe:native-host": "node scripts/native-host-probe/composition.mjs",
    "probe:runtime": "pnpm --filter dsh-multi-tenant exec tsx ../../scripts/native-host-probe/lifecycle.mjs",
    "probe:isolated": "pnpm --filter dsh-multi-tenant exec tsx ../../scripts/native-host-probe/isolated.mjs",
    "smoke": "node scripts/artifact-consumer-smoke.mjs --local",
    "release:preflight": "node scripts/release-preflight.mjs",
    "release:check": "pnpm verify && pnpm release:preflight && pnpm peers:check && pnpm typecheck && pnpm test && pnpm build && pnpm probe:sqlite && pnpm smoke"
  }
}
